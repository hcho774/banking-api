// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/prisma/prismaClient"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator prismaClassGenerator {
  provider               = "prisma-class-generator"
  useSwagger             = "false"
  dryRun                 = "false"
  separateRelationFields = "true"
  output                 = "../src/prisma/schema"
}

model Account {
  accountId            String        @id @default(uuid())
  personId             Int
  balance              Int           @default(0)
  dailyWithdrawalLimit Int
  activeFlag           Boolean       @default(true)
  accountType          Int
  createDate           DateTime      @default(now())
  person               Person        @relation(fields: [personId], references: [personId])
  transactions         Transaction[]

  @@map("accounts")
}

model Person {
  personId  Int       @id @default(autoincrement())
  publicId  String    @unique @default(uuid())
  name      String
  document  String    @unique
  birthDate DateTime
  status    Int       @default(0)
  deletedAt DateTime?
  accounts  Account[]

  @@map("person")
}

model Transaction {
  transactionId   String   @id @default(uuid())
  accountId       String
  value           Int
  transactionDate DateTime @default(now())
  idempotencyKey  String?  @unique
  type            Int
  account         Account  @relation(fields: [accountId], references: [accountId])

  @@index([accountId, transactionDate])
  @@map("transactions")
}
