{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug NestJS (Watch)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug"],
      "sourceMaps": true,
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "restart": true,
      "autoAttachChildProcesses": true
    }
  ]
}
